        "jsCode": "const res = $input.first().json;\n\n// Handle both possible shapes:\n//   { body: { products: [...] } }   ← HTTP node with full response\n//   { products: [...] }              ← HTTP node with body only\nconst products = res.body?.products ?? res.products ?? [];\n\nreturn products.map(p => ({ json: p }));"
