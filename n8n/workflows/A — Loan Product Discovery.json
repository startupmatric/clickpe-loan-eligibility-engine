    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO loan_products\n  (product_name, provider, interest_rate, min_monthly_income,\n   min_credit_score, min_age, max_age, employment_statuses,\n   eligibility_text, source_url, last_updated)\nVALUES\n  ($1, $2, $3, $4, $5, $6, $7,\n   (SELECT array_agg(x)::text[] FROM jsonb_array_elements_text($8::jsonb) AS t(x)),\n   $9, $10, NOW())\nON CONFLICT (product_name, provider) DO UPDATE\n   SET interest_rate       = EXCLUDED.interest_rate,\n       min_monthly_income  = EXCLUDED.min_monthly_income,\n       min_credit_score    = EXCLUDED.min_credit_score,\n       min_age             = EXCLUDED.min_age,\n       max_age             = EXCLUDED.max_age,\n       employment_statuses = EXCLUDED.employment_statuses,\n       eligibility_text    = EXCLUDED.eligibility_text,\n       source_url          = EXCLUDED.source_url,\n       last_updated        = NOW()\nRETURNING id, product_name;\n",
        "options": {
          "queryReplacement": "={{ $json.product_name }}\n{{ $json.provider }}\n{{ $json.interest_rate }}\n{{ $json.min_monthly_income }}\n{{ $json.min_credit_score }}\n{{ $json.min_age }}\n{{ $json.max_age }}\n{{ JSON.stringify($json.employment_statuses) }}\n{{ $json.eligibility_text }}\n{{ $json.source_url }}"
        }
      },
