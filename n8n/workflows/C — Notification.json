    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    m.user_id,\n    u.email,\n    json_agg(\n        json_build_object(\n            'product_name',  p.product_name,\n            'provider',      p.provider,\n            'interest_rate', p.interest_rate,\n            'match_score',   m.match_score\n        ) ORDER BY m.match_score DESC\n    ) AS products\nFROM matches m\nJOIN loan_products p ON p.id = m.product_id\nJOIN users u ON u.user_id = m.user_id\nWHERE m.notified_at IS NULL\nGROUP BY m.user_id, u.email\nLIMIT 50;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "id": "502f7f8d-4d85-407f-94ab-0dd08eb6525f",
      "name": "Execute a SQL query",
      "credentials": {
        "postgres": {
          "id": "6eNOaDrFcqGpOfua",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\n\nfor (const item of $input.all()) {\n  const { user_id, email, products } = item.json;\n\n  const list = products.map((p, i) =>\n    `${i + 1}. ${p.product_name} (${p.provider})\\n` +\n    `   Interest Rate: ${p.interest_rate}% onwards\\n` +\n    `   Match Score: ${p.match_score}/100`\n  ).join(\"\\n\\n\");\n\n  const body =\n`Hi,\n\nBased on your profile, you may be eligible for the following loan products:\n\n${list}\n\nThese are potential matches based on publicly available eligibility criteria.\nFinal approval is subject to the lender's underwriting.\n\nRegards,\nClickPe Loan Eligibility Engine`;\n\n  out.push({\n    json: {\n      user_id,\n      email,\n      subject: \"Your loan eligibility matches\",\n      body\n    }\n  });\n}\n\nreturn out;"
      },
